# Application Environment
APP_ENV=development
APP_PORT=8000
SECRET_KEY=change-me-in-production-use-a-secure-random-key-32-chars
DEBUG=false
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Supabase (Database & Auth)
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

# Cloudflare R2 (S3-compatible API)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=doc-action-vault-dev
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# AI Gateway & Models
PORTKEY_API_KEY=your-portkey-api-key
PORTKEY_VIRTUAL_KEY=your-portkey-virtual-key
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key

# Upstash Redis & Kafka
UPSTASH_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_TOKEN=
UPSTASH_KAFKA_URL=
UPSTASH_KAFKA_TOKEN=

# Notifications & Billing
FIREBASE_SERVICE_ACCOUNT_JSON=
REVENUECAT_APP_ID=
REVENUECAT_API_KEY=
