{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Docker: Start Infra (Postgres, Redis, MinIO)",
      "type": "shell",
      "command": "docker compose up -d postgres redis minio minio-init",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Docker: Stop Infra",
      "type": "shell",
      "command": "docker compose down",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
