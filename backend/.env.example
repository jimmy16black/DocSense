APP_ENV=development
APP_PORT=8000
SECRET_KEY=dev-secret-key-docsense-action-dev-32-chars
DEBUG=true
ALLOWED_ORIGINS=*

SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=test-anon-key
SUPABASE_SERVICE_ROLE_KEY=test-service-key
SUPABASE_JWT_SECRET=test-jwt-secret-at-least-32-chars-long
SUPABASE_DB_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/postgres

CLOUDFLARE_ACCOUNT_ID=test-account-id
R2_ACCESS_KEY_ID=test-access-key
R2_SECRET_ACCESS_KEY=test-secret-key
R2_BUCKET_NAME=doc-action-vault-dev
R2_ENDPOINT_URL=https://test-account-id.r2.cloudflarestorage.com

PORTKEY_API_KEY=test-portkey-key
PORTKEY_VIRTUAL_KEY=test-virtual-key
GEMINI_API_KEY=test-gemini-key
OPENAI_API_KEY=test-openai-key

UPSTASH_REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_TOKEN=

# Test-only auth bypass for "test-token-*" mock identities (ISSUE-006).
# MUST remain false in every deployed environment (dev/staging/prod).
# Only the automated test suite (tests/conftest.py) enables it.
ALLOW_TEST_TOKENS=false
